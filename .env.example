# URL of the InsafDost FastAPI backend (no trailing slash needed).
# Must be reachable from the browser. It is also added to the CSP connect-src.
NEXT_PUBLIC_API_BASE_URL=https://abdurrafay-codes-insaf-dost-backend.hf.space

# Public URL of this site. Used for canonical URLs, Open Graph, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://insafdostai.abdurrafaylabs.tech

# Optional. Shown on the privacy page. If unset, the page links to the repository.
# NEXT_PUBLIC_CONTACT_EMAIL=
